{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "h",           // pretend package name
    "baseUrl": "src",                 // resolve imports from src/
    "paths": {
      "h": ["./h"]                    // map "h" → src/h
    }
  },
  "include": ["src"]
}
